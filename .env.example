NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler, port 6543 — app runtime, seed, all non-migration code.
DATABASE_URL=
# Optional alias overriding DATABASE_URL for runtime pooler.
DATABASE_POOLER_URL=
# Direct, port 5432 — drizzle-kit migrate/generate + pg_dump ONLY.
DIRECT_DATABASE_URL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Local dev SMTP (e.g. Mailpit, no auth). When SMTP_HOST is set it wins
# over the Gmail path above. Mailpit defaults:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER= (only if your local server needs auth)
# SMTP_PASS= (only if your local server needs auth)
MAIL_FROM=noreply@localhost
APP_URL=http://localhost:3000
# Vercel Cron authentication (set the same secret in Vercel Production env)
CRON_SECRET=
# Sentry (free plan, errors only; absent DSN = silent no-op)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sourcemap upload only (build-time; leave unset to skip upload)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
