{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/outbox",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "10 2 * * *"
    }
  ]
}
